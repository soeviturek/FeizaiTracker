<UserControl x:Class="FeizaiTracker.App.Views.InsightsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FeizaiTracker.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="34,2,34,34">
            <ComboBox ItemsSource="{Binding RangeOptions}"
                      SelectedItem="{Binding SelectedRange}"
                      DisplayMemberPath="Label"
                      HorizontalAlignment="Right"
                      Width="160"
                      Margin="0,0,0,16" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="AVERAGE"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="10"
                                   FontWeight="Bold" />
                        <TextBlock Text="{Binding AverageCalories, StringFormat={}{0:0} kcal}"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Margin="0,7,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="CONSISTENCY"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="10"
                                   FontWeight="Bold" />
                        <TextBlock Text="{Binding Consistency, StringFormat={}{0:0}%}"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Margin="0,7,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource Card}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="CURRENT STREAK"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="10"
                                   FontWeight="Bold" />
                        <TextBlock Text="{Binding CurrentStreak, StringFormat={}{0} days}"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Margin="0,7,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="6" Style="{StaticResource Card}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="ON-TARGET DAYS"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="10"
                                   FontWeight="Bold" />
                        <TextBlock Text="{Binding GoalDays}"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Margin="0,7,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}"
                    Margin="0,16,0,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Calorie trend"
                                   Style="{StaticResource SectionHeading}" />
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Border Width="18"
                                    Height="3"
                                    Background="{StaticResource OrangeBrush}"
                                    VerticalAlignment="Center"
                                    Margin="0,0,7,0" />
                            <TextBlock Text="Daily target"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="11" />
                        </StackPanel>
                    </Grid>
                    <controls:TrendChart Items="{Binding ChartPoints}"
                                         Target="{Binding DailyTarget}"
                                         Height="275"
                                         Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}"
                    Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Tracked days"
                               Style="{StaticResource SectionHeading}" />

                    <StackPanel Margin="0,24"
                                HorizontalAlignment="Center"
                                Visibility="{Binding HasHistory, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <TextBlock Text="Start logging to see your history"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Even one entry a day builds a useful trend."
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   Margin="0,5,0,0" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding History}"
                                  Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding DateLabel}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <ProgressBar Grid.Column="1"
                                                 Style="{StaticResource SlimProgress}"
                                                 Minimum="0"
                                                 Maximum="150"
                                                 Value="{Binding TargetPercentage, Mode=OneWay}"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,24,0" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Calories, StringFormat={}{0:0} kcal}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding Status}"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
