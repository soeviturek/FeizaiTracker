<UserControl x:Class="FeizaiTracker.App.Views.MeasurementsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FeizaiTracker.App.Controls">
    <Grid Margin="34,2,34,34">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource Card}"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Your measurements"
                               Style="{StaticResource SectionHeading}" />
                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding Metrics}"
                             SelectedItem="{Binding SelectedMetric}"
                             VirtualizingPanel.IsVirtualizing="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Unit}"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontSize="11"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#FAFCFA" />
                                            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                             Value="True">
                                                    <Setter Property="Background" Value="{StaticResource PaleGreenBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource GreenBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Style="{StaticResource Card}"
                    Padding="16">
                <StackPanel>
                    <TextBlock Text="New custom metric"
                               FontSize="15"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Examples: Biceps, Waist, Body fat"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="11"
                               Margin="0,4,0,12" />
                    <TextBlock Text="Name"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Margin="0,0,0,5" />
                    <TextBox Text="{Binding CustomMetricName, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="40" />
                    <TextBlock Text="Unit"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Margin="0,10,0,5" />
                    <ComboBox ItemsSource="{Binding UnitSuggestions}"
                              IsEditable="True"
                              Text="{Binding CustomMetricUnit, UpdateSourceTrigger=PropertyChanged}"
                              MaxDropDownHeight="220" />
                    <Button Content="Create metric"
                            Command="{Binding CreateMetricCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,11,0,0" />
                    <TextBlock Text="{Binding CustomMetricStatusMessage}"
                               Foreground="{StaticResource GreenBrush}"
                               FontSize="11"
                               Margin="0,8,0,0"
                               Visibility="{Binding HasCustomMetricStatusMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </Border>
        </Grid>

        <ScrollViewer Grid.Column="2"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedMetric.Name}"
                                           Style="{StaticResource SectionHeading}" />
                                <TextBlock Foreground="{StaticResource MutedBrush}"
                                           FontSize="12"
                                           Margin="0,4,0,0">
                                    <Run Text="One value per day, measured in " />
                                    <Run Text="{Binding SelectedMetric.Unit}" />
                                </TextBlock>
                            </StackPanel>
                            <Button Content="Delete custom metric"
                                    Command="{Binding DeleteMetricCommand}"
                                    Style="{StaticResource TextButton}"
                                    Foreground="#A35D58"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Visibility="{Binding CanDeleteSelectedMetric, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>

                        <Grid Margin="0,18,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="6" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Date"
                                       FontSize="11"
                                       FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2"
                                       FontSize="11"
                                       FontWeight="SemiBold">
                                <Run Text="Value (" />
                                <Run Text="{Binding SelectedMetricUnit}" />
                                <Run Text=")" />
                            </TextBlock>
                            <DatePicker Grid.Row="2"
                                        SelectedDate="{Binding EntryDate}"
                                        DisplayDateStart="{Binding MinimumEntryDate}"
                                        DisplayDateEnd="{Binding MaximumEntryDate}" />
                            <TextBox Grid.Row="2"
                                     Grid.Column="2"
                                     Text="{Binding EntryValue, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="16" />
                            <Button Grid.Row="2"
                                    Grid.Column="4"
                                    Content="Save measurement"
                                    Command="{Binding SaveEntryCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    VerticalAlignment="Stretch" />
                        </Grid>
                        <TextBlock Text="Saving the same date again updates that day's value."
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="10"
                                   Margin="0,8,0,0" />
                        <TextBlock Text="{Binding EntryStatusMessage}"
                                   Foreground="{StaticResource GreenBrush}"
                                   FontSize="12"
                                   Margin="0,8,0,0"
                                   Visibility="{Binding HasEntryStatusMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </Border>

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="LATEST"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="10"
                                       FontWeight="Bold" />
                            <TextBlock Text="{Binding LatestValueLabel}"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="CHANGE"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="10"
                                       FontWeight="Bold" />
                            <TextBlock Text="{Binding ChangeLabel}"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource Card}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="MINIMUM"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="10"
                                       FontWeight="Bold" />
                            <TextBlock Text="{Binding MinimumLabel}"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="6" Style="{StaticResource Card}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="MAXIMUM"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="10"
                                       FontWeight="Bold" />
                            <TextBlock Text="{Binding MaximumLabel}"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource Card}"
                        Margin="0,16,0,0">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Trend"
                                       Style="{StaticResource SectionHeading}"
                                       VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                <ComboBox ItemsSource="{Binding ChartTypes}"
                                          SelectedItem="{Binding SelectedChartType}"
                                          Width="105" />
                                <ComboBox ItemsSource="{Binding RangeOptions}"
                                          SelectedItem="{Binding SelectedRange}"
                                          DisplayMemberPath="Label"
                                          Width="130"
                                          Margin="8,0,0,0" />
                            </StackPanel>
                        </Grid>
                        <controls:MeasurementChart Items="{Binding ChartPoints}"
                                                   ChartType="{Binding SelectedChartType}"
                                                   Unit="{Binding SelectedMetricUnit}"
                                                   Height="285"
                                                   Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}"
                        Margin="0,16,0,0">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="History"
                                       Style="{StaticResource SectionHeading}" />
                            <TextBlock Text="{Binding HistoryCountLabel}"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="11"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <StackPanel Margin="0,24"
                                    HorizontalAlignment="Center"
                                    Visibility="{Binding HasHistory, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                            <TextBlock Text="No measurements in this range"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Add the first value above or choose a longer range."
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="12"
                                       Margin="0,5,0,0" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding History}"
                                      Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource LineBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="42" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding DateLabel}"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ValueLabel}"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center" />
                                            <Button Grid.Column="2"
                                                    Content="&#xE74D;"
                                                    FontFamily="Segoe MDL2 Assets"
                                                    Foreground="#A35D58"
                                                    ToolTip="Remove measurement"
                                                    Style="{StaticResource TextButton}"
                                                    HorizontalAlignment="Right"
                                                    Command="{Binding DataContext.RemoveEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
